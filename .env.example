# ═══════════════════════════════════════════════════════
#  OPENSPIRED — Configuration Template
#  Copy this file to .env and fill in your values.
#  Run: cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── AI Provider ───────────────────────────────────────
# Choose one: anthropic | google | openai
PROVIDER=google

# ── API Keys (only the one for your chosen provider) ──
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Model ─────────────────────────────────────────────
# Recommended (cheap + capable): gemini-2.5-flash-lite
# Fallback on overload:           gemini-2.5-flash
# Anthropic option:               claude-haiku-4-5-20251001
DEFAULT_MODEL=gemini-2.5-flash-lite

# ── Pipeline Options ──────────────────────────────────
USE_CACHE=true
MAX_TOKENS=8192
MAX_REVISIONS=2

# ── Jira Integration (optional) ───────────────────────
# Leave blank to use manual input mode only.
# Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_PROJECT_KEY_SECONDARY=ANA

# ── Domain config (set by setup wizard, override if needed) ───────────────────
# DOMAIN_PRIMARY: your main product / back-office domain name
# DOMAIN_SECONDARY: your analytics / data domain name
DOMAIN_PRIMARY=App
DOMAIN_SECONDARY=Analytics

# ── Product Guide (optional but highly recommended) ────────────────────────────
# Create workspace/context/product_guide.md with a description of your product:
# current modules, key UX patterns, component library, role definitions (BASIC/FULL).
# This file is injected as CDP Layer 2 into Dev Concepto and Escritor on every run.
# Without it, agents use only product_knowledge.md — the guide improves ticket quality.
# Legacy path also accepted: {DOMAIN_PRIMARY}/Guia_Maestra_{DOMAIN_PRIMARY}.md
