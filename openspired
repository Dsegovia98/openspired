#!/usr/bin/env bash
# Openspired one-command launcher.
# - Default: web mode (lowest friction).
# - Optional: desktop mode with Tauri.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

MODE="web"
NO_OPEN="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --web)
      MODE="web"
      shift
      ;;
    --desktop)
      MODE="desktop"
      shift
      ;;
    --no-open)
      NO_OPEN="true"
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: ./openspired [--web|--desktop] [--no-open]

Options:
  --web       Run local API + web UI (default).
  --desktop   Run local API + Tauri desktop window.
  --no-open   Do not auto-open browser in web mode.
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      echo "Try: ./openspired --help"
      exit 1
      ;;
  esac
done

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

choose_python() {
  if has_cmd python3; then
    echo "python3"
  elif has_cmd python; then
    echo "python"
  else
    echo ""
  fi
}

wait_for_url() {
  local url="$1"
  local timeout_secs="${2:-30}"
  local start now
  start="$(date +%s)"
  while true; do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start >= timeout_secs )); then
      return 1
    fi
    sleep 1
  done
}

open_url() {
  local url="$1"
  if [[ "$NO_OPEN" == "true" ]]; then
    return 0
  fi
  if has_cmd open; then
    open "$url" >/dev/null 2>&1 || true
  elif has_cmd xdg-open; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
}

ensure_python_deps() {
  local py="$1"
  if ! "$py" - <<'PY' >/dev/null 2>&1
import fastapi, uvicorn, dotenv, yaml
PY
  then
    echo -e "${CYAN}Installing Python dependencies...${RESET}"
    "$py" -m pip install -r requirements.txt
  fi
}

ensure_node_deps() {
  if [[ ! -d "desktop/node_modules" ]]; then
    echo -e "${CYAN}Installing desktop dependencies...${RESET}"
    npm --prefix desktop install
  fi
}

pick_web_port() {
  local candidate
  for candidate in 1420 1421 1422 1423 1424 1425; do
    if ! lsof -nP -iTCP:"$candidate" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

PYTHON_CMD="$(choose_python)"
if [[ -z "$PYTHON_CMD" ]]; then
  echo -e "${RED}Python 3.10+ is required.${RESET}"
  exit 1
fi

if ! has_cmd curl; then
  echo -e "${RED}curl is required.${RESET}"
  exit 1
fi

if ! has_cmd npm; then
  echo -e "${RED}npm is required to run the UI.${RESET}"
  exit 1
fi

PROFILE_PATH="${OPENSPIRED_PROFILE_PATH:-$HOME/.openspired/profiles/default}"
export OPENSPIRED_PROFILE_PATH="$PROFILE_PATH"
export OPENSPIRED_REQUIRE_PROFILE="true"

if [[ ! -f "$PROFILE_PATH/profile.toml" ]]; then
  echo -e "${CYAN}Bootstrapping profile at ${PROFILE_PATH}...${RESET}"
  "$PYTHON_CMD" engine/profile_cli.py init --path "$PROFILE_PATH" --name "default" >/dev/null
fi

mkdir -p "$PROFILE_PATH/workspace/context/.reasoning_bank" \
         "$PROFILE_PATH/workspace/context/modules" \
         "$PROFILE_PATH/workspace/context/artifacts" \
         "$PROFILE_PATH/workspace/context/tickets" \
         "$PROFILE_PATH/workspace/artifacts/ideas" \
         "$PROFILE_PATH/workspace/artifacts/research" \
         "$PROFILE_PATH/workspace/artifacts/prds" \
         "$PROFILE_PATH/workspace/artifacts/dts" \
         "$PROFILE_PATH/workspace/artifacts/uss" \
         "$PROFILE_PATH/workspace/links" \
         "$PROFILE_PATH/workspace/modules" \
         "$PROFILE_PATH/workspace/tickets" \
         "$PROFILE_PATH/workspace/logs/pipeline_runs"

if [[ ! -f "$PROFILE_PATH/workspace/links/relations.ndjson" ]]; then
  : > "$PROFILE_PATH/workspace/links/relations.ndjson"
fi

if [[ ! -f "$PROFILE_PATH/.env" ]]; then
  cp .env.example "$PROFILE_PATH/.env"
  echo -e "${YELLOW}Created profile .env from template at ${PROFILE_PATH}/.env${RESET}"
fi

ensure_python_deps "$PYTHON_CMD"
ensure_node_deps

API_LOG="$PROFILE_PATH/workspace/logs/launcher_api.log"
WEB_LOG="$PROFILE_PATH/workspace/logs/launcher_web.log"
API_PID=""
WEB_PID=""
API_STARTED_BY_LAUNCHER="false"

cleanup() {
  if [[ -n "$WEB_PID" ]]; then
    kill "$WEB_PID" >/dev/null 2>&1 || true
  fi
  if [[ "$API_STARTED_BY_LAUNCHER" == "true" && -n "$API_PID" ]]; then
    kill "$API_PID" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

if wait_for_url "http://127.0.0.1:8765/health" 1; then
  echo -e "${GREEN}API already running at http://127.0.0.1:8765${RESET}"
else
  echo -e "${CYAN}Starting local API...${RESET}"
  "$PYTHON_CMD" engine/run.py --serve-api >"$API_LOG" 2>&1 &
  API_PID="$!"
  API_STARTED_BY_LAUNCHER="true"
  if ! wait_for_url "http://127.0.0.1:8765/health" 45; then
    echo -e "${RED}API failed to start. Log:${RESET} $API_LOG"
    tail -n 80 "$API_LOG" || true
    exit 1
  fi
  echo -e "${GREEN}API ready on http://127.0.0.1:8765${RESET}"
fi

if [[ "$MODE" == "desktop" ]]; then
  if ! has_cmd cargo; then
    echo -e "${YELLOW}Rust/Cargo not found. Falling back to web mode.${RESET}"
    MODE="web"
  fi
fi

if [[ "$MODE" == "desktop" ]]; then
  echo -e "${CYAN}Opening desktop window (Tauri)...${RESET}"
  npm --prefix desktop run tauri dev
  exit 0
fi

WEB_PORT="$(pick_web_port || true)"
if [[ -z "${WEB_PORT:-}" ]]; then
  echo -e "${RED}No available port found for web UI (1420-1425).${RESET}"
  exit 1
fi

WEB_URL="http://127.0.0.1:${WEB_PORT}"
echo -e "${CYAN}Starting web UI on ${WEB_URL}...${RESET}"
npm --prefix desktop run dev -- --host 127.0.0.1 --port "$WEB_PORT" >"$WEB_LOG" 2>&1 &
WEB_PID="$!"

if ! wait_for_url "$WEB_URL" 45; then
  echo -e "${RED}Web UI failed to start. Log:${RESET} $WEB_LOG"
  tail -n 80 "$WEB_LOG" || true
  exit 1
fi

open_url "$WEB_URL"

echo -e "${GREEN}Openspired is running.${RESET}"
echo "API:  http://127.0.0.1:8765"
echo "Web:  ${WEB_URL}"
echo "Profile: ${PROFILE_PATH}"
echo "Press Ctrl+C to stop."

wait "$WEB_PID"
