# ══════════════════════════════════════════════════════════════════
#  Openspired Pipeline — Configuración
#  cp .env.example .env  →  edita con tus valores
# ══════════════════════════════════════════════════════════════════

# ── Proveedor activo ──────────────────────────────────────────────
# Opciones: anthropic | openai | google
PROVIDER=google

# ── API Keys (solo la del proveedor activo es obligatoria) ────────
ANTHROPIC_API_KEY=sk-ant-...      # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=sk-...             # https://platform.openai.com/api-keys
GOOGLE_API_KEY=AIza...            # https://aistudio.google.com/apikey  (GRATIS para empezar)

# ── Modelo por defecto (aplica a TODOS los agentes) ───────────────
#
#  ANTHROPIC — precio por millón de tokens (input / output):
#    claude-haiku-4-5-20251001   →  $0.80 / $4.00   ← recomendado
#    claude-sonnet-4-6           →  $3.00 / $15.00
#    claude-opus-4-6             →  $15.0 / $75.00
#
#  OPENAI:
#    gpt-4o-mini                 →  $0.15 / $0.60   ← muy recomendado
#    gpt-4o                      →  $2.50 / $10.00
#
#  GOOGLE:
#    gemini-2.5-flash-lite        →  $0.10 / $0.40   ← más barato
#    gemini-1.5-flash-latest     →  $0.075/ $0.30
#
DEFAULT_MODEL=gemini-2.5-flash-lite

# ── Prompt Caching — solo Anthropic (90% descuento en input repetido)
USE_CACHE=true

# ── Tokens máximos por respuesta de agente ────────────────────────
MAX_TOKENS=8192

# ── Anti-loop guardrail (máx revisiones antes de escalar al PO) ──
MAX_REVISIONS=2

# ── Override por agente (opcional) ───────────────────────────────
# Descomenta para usar un modelo más potente en agentes críticos.
# Los demás seguirán usando DEFAULT_MODEL.
#
# MODEL_ESCRITOR=claude-sonnet-4-6
# MODEL_DEV_CONCEPTO=claude-sonnet-4-6
# MODEL_FEEDBACK=claude-sonnet-4-6
# MODEL_ORQUESTADOR=claude-sonnet-4-6
