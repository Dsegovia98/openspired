{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openspired Desktop",
  "version": "0.1.0",
  "identifier": "com.openspired.desktop",
  "build": {
    "beforeDevCommand": "bash scripts/tauri-before-dev.sh",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Openspired Desktop",
        "width": 1320,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../engine/**/*",
      "../../agents/**/*",
      "../../templates/**/*",
      "../../requirements.txt",
      "../../.env.example"
    ]
  }
}
